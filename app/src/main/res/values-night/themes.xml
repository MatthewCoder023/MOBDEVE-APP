<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night overrides: a lighter primary so M3 components (switches, checkboxes,
         text fields) stay visible on dark surfaces, and dark status-bar icons off.
         Everything else (type, shape, button/card styles) is inherited from the
         light theme via the shared style names. -->
    <style name="Theme.UniSync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/light_green</item>
        <item name="colorSecondary">@color/light_green</item>
        <item name="android:colorAccent">@color/light_green</item>
        <item name="materialButtonStyle">@style/Widget.UniSync.Button</item>

        <!-- Same colour-role mapping as the light theme; every value below has a
             values-night variant, so the two blocks stay identical on purpose. -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface</item>
        <item name="colorSurfaceVariant">@color/background</item>
        <!-- No elevation tint: raised surfaces (dialogs, menus) stay the same
             flat white as the cards instead of picking up a green wash from the
             primary colour. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOnSurface">@color/dark_gray_text</item>
        <item name="colorOnSurfaceVariant">@color/muted_text</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_accent</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_accent</item>
        <!-- Tertiary drives the time picker's AM/PM toggle, which was rendering
             pink; error drives text-field error states. Both map onto the app's
             own palette so no baseline colour survives anywhere. -->
        <item name="colorTertiary">@color/brand_accent</item>
        <item name="colorTertiaryContainer">@color/brand_container</item>
        <item name="colorOnTertiaryContainer">@color/brand_accent</item>
        <item name="colorError">@color/status_high</item>
        <item name="colorErrorContainer">@color/status_high_container</item>
        <item name="colorOnErrorContainer">@color/status_high</item>
        <item name="android:colorBackground">@color/background</item>

        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UniSync.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.UniSync.CardTitle</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UniSync.Subtitle</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.UniSync.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.UniSync.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.UniSync.Large</item>
    </style>
</resources>
