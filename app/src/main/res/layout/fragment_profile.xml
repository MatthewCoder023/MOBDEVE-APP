<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <com.dlsu.unisync.views.ScreenHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:headerTitle="@string/title_profile" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UniSync.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/space_xl">

                <!-- Monogram avatar; initials are set at runtime from the
                     signed-in user's name. -->
                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:background="@drawable/bg_icon_circle"
                    android:backgroundTint="@color/dark_green">

                    <TextView
                        android:id="@+id/avatarInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.UniSync.SectionTitle"
                        android:textColor="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.UniSync.SectionTitle"
                        tools:text="Mika Santos" />

                    <TextView
                        android:id="@+id/profileDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.UniSync.Subtitle"
                        tools:text="mika_santos@dlsu.edu.ph" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:accessibilityHeading="true"
            android:text="@string/profile_preferences"
            android:textAppearance="@style/TextAppearance.UniSync.SectionTitle" />

        <!-- The toggles sit on a card like every other block of content, instead
             of floating directly on the background, and each says what it does. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UniSync.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/notificationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:checked="true"
                    android:text="@string/pref_reminders"
                    android:textAppearance="@style/TextAppearance.UniSync.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_reminders_detail"
                    android:textAppearance="@style/TextAppearance.UniSync.CardSubtitle" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/card_stroke"
                    android:layout_marginVertical="@dimen/space_lg"
                    android:background="@color/soft_line" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/crowdSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target"
                    android:checked="true"
                    android:text="@string/pref_crowd_alerts"
                    android:textAppearance="@style/TextAppearance.UniSync.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pref_crowd_alerts_detail"
                    android:textAppearance="@style/TextAppearance.UniSync.CardSubtitle" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Outlined, not filled: signing out is a way out, not the thing the
             screen wants you to do. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/Widget.UniSync.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/action_logout" />
    </LinearLayout>
</ScrollView>
