<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Text set at runtime: time-of-day greeting with the profile name. -->
        <TextView
            android:id="@+id/greetingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.UniSync.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/dashboard_subtitle"
            android:textAppearance="@style/TextAppearance.UniSync.Subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_green_gradient"
            android:elevation="@dimen/card_elevation"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_next_class_label"
                android:textAppearance="@style/TextAppearance.UniSync.HeroLabel" />

            <!-- Text set at runtime from the schedule data. -->
            <TextView
                android:id="@+id/nextClassValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.UniSync.HeroValue" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:columnCount="2">

            <!-- Shortcuts are secondary to the hero card above, so they use the
                 tonal style rather than competing filled green. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openCrowdButton"
                style="@style/Widget.UniSync.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/shortcut_crowd"
                app:icon="@drawable/ic_crowd" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openQrButton"
                style="@style/Widget.UniSync.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/title_qr"
                app:icon="@drawable/ic_qr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openNotificationsButton"
                style="@style/Widget.UniSync.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_columnWeight="1"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/space_sm"
                android:text="@string/shortcut_alerts"
                app:icon="@drawable/ic_alerts" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openScheduleButton"
                style="@style/Widget.UniSync.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_columnWeight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/nav_schedule"
                app:icon="@drawable/ic_nav_schedule" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:accessibilityHeading="true"
            android:text="@string/dashboard_today"
            android:textAppearance="@style/TextAppearance.UniSync.SectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboardRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:id="@+id/dashboardEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_today"
                app:tint="@color/empty_icon_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/dashboard_today_empty"
                android:textAppearance="@style/TextAppearance.UniSync.Subtitle" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
