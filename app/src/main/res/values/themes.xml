<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight with full night resources (values-night/). Status/navigation bar
         colors come from enableEdgeToEdge() in code; the XML attributes for them
         are deprecated as of API 35. -->
    <style name="Theme.UniSync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimary">@color/dark_green</item>
        <item name="colorSecondary">@color/light_green</item>
        <item name="android:colorAccent">@color/dark_green</item>
        <item name="materialButtonStyle">@style/Widget.UniSync.Button</item>

        <!-- Type scale: one font family for the whole app. -->
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.UniSync.ScreenTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.UniSync.CardTitle</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.UniSync.Subtitle</item>

        <!-- Shape scale, backed by the radius_* tokens in dimens.xml. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.UniSync.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.UniSync.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.UniSync.Large</item>
    </style>

    <!-- Launch theme for the SplashScreen API; swaps to Theme.UniSync once the
         first frame is ready. Brand green in both light and dark mode. -->
    <style name="Theme.UniSync.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dark_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_monogram</item>
        <item name="postSplashScreenTheme">@style/Theme.UniSync</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.UniSync.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="ShapeAppearance.UniSync.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="ShapeAppearance.UniSync.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <!-- App-wide button styles so layouts stop repeating tint/corner attributes.
         Colors are state lists, not plain colors: a plain color would replace
         Material's own state list and leave disabled buttons looking tappable. -->
    <style name="Widget.UniSync.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_bg_primary</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_fg_on_primary</item>
        <item name="iconTint">@color/button_fg_on_primary</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="Widget.UniSync.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Secondary actions: present but visibly quieter than the filled green,
         so each screen has one obvious primary action. -->
    <style name="Widget.UniSync.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/button_bg_tonal</item>
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_fg_tonal</item>
        <item name="iconTint">@color/button_fg_tonal</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="Widget.UniSync.Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/button_bg_primary</item>
        <item name="android:textColor">@color/button_fg_on_primary</item>
        <item name="iconTint">@color/button_fg_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!-- Shared card style: tonal surface with a hairline outline instead of a
         heavy drop shadow, which reads better in dark mode. -->
    <style name="Widget.UniSync.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/soft_line</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <!-- Shared text styles so screens stay consistent; use these instead of
         repeating textColor/textSize/textStyle triplets in layouts. -->
    <style name="TextAppearance.UniSync.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/dark_gray_text</item>
    </style>

    <style name="TextAppearance.UniSync.ScreenTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/dark_gray_text</item>
    </style>

    <style name="TextAppearance.UniSync.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/muted_text</item>
    </style>

    <style name="TextAppearance.UniSync.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/dark_gray_text</item>
    </style>

    <style name="TextAppearance.UniSync.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:textColor">@color/dark_gray_text</item>
    </style>

    <style name="TextAppearance.UniSync.CardSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/muted_text</item>
    </style>

    <!-- Small uppercase label used for status chips. -->
    <style name="TextAppearance.UniSync.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.UniSync.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/dark_gray_text</item>
    </style>

    <!-- Wordmark shown in the scanner frame before the camera starts. -->
    <style name="TextAppearance.UniSync.QrPlaceholder" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/brand_accent</item>
    </style>

    <!-- On-gradient text for the dashboard hero card: always white in both modes. -->
    <style name="TextAppearance.UniSync.HeroLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextAppearance.UniSync.HeroValue" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/manrope_bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
