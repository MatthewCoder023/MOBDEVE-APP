<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 4dp-based spacing scale. Use these instead of typing dp values into
         layouts, so screens stay on the same rhythm. -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>
    <dimen name="space_xxxl">48dp</dimen>

    <!-- Shape scale, mirrored by the theme's shapeAppearance* attributes. -->
    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>
    <!-- Reserved for the largest surfaces, currently the dashboard hero card. -->
    <dimen name="radius_xl">24dp</dimen>

    <dimen name="screen_padding">20dp</dimen>
    <!-- Scanner frame. The base value is deliberately small so the check-in list
         below it still gets room on short screens; taller and wider devices get
         a bigger frame from values-h640dp and values-sw600dp. -->
    <dimen name="qr_frame_size">200dp</dimen>
    <dimen name="card_radius">@dimen/radius_lg</dimen>
    <dimen name="card_elevation">1dp</dimen>

    <!-- Components -->
    <dimen name="list_icon_size">40dp</dimen>
    <dimen name="list_icon_inner">22dp</dimen>
    <dimen name="button_height">56dp</dimen>
    <!-- Material's minimum tap target; use it for rows that are tappable but
         size themselves to their content. -->
    <dimen name="touch_target">48dp</dimen>
    <dimen name="empty_icon_size">48dp</dimen>
    <!-- In-button spinner: small enough to sit inside the button's height. -->
    <dimen name="spinner_size">24dp</dimen>
    <dimen name="spinner_track">3dp</dimen>
    <!-- Bottom padding on FAB-bearing lists so the last card stays tappable. -->
    <dimen name="fab_clearance">88dp</dimen>
    <dimen name="avatar_size">56dp</dimen>
    <!-- Occupancy bar; the radius is half the thickness so the track is a pill. -->
    <dimen name="progress_thickness">6dp</dimen>
    <dimen name="progress_radius">3dp</dimen>
    <dimen name="card_stroke">1dp</dimen>
    <dimen name="card_stroke_selected">2dp</dimen>
</resources>
