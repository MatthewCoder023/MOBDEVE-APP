<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- dark_green doubles as a container color (buttons, launcher icon) and is
         intentionally NOT themed for night. For green text/icons use
         brand_accent, which lightens in dark mode. "white" stays literal white
         (text on green surfaces); use "surface" for card/nav backgrounds. -->
    <color name="dark_green">#006B3C</color>
    <color name="light_green">#6FCF97</color>
    <color name="brand_accent">#006B3C</color>
    <color name="background">#F7F9F8</color>
    <color name="surface">#FFFFFF</color>
    <color name="dark_gray_text">#222222</color>
    <color name="white">#FFFFFF</color>
    <!-- Darkened from #66756D: that shade was ~4.6:1 against the app background,
         barely past the 4.5:1 WCAG AA line; this one is ~5.5:1. -->
    <color name="muted_text">#5A6961</color>
    <color name="soft_line">#DDE7E1</color>
    <!-- Light end of the dashboard hero gradient. It used to run to light_green
         (#6FCF97), where the card's white text landed at about 1.9:1 contrast,
         effectively unreadable. This shade keeps the sweep but holds white above
         5:1 across the whole card. -->
    <color name="hero_gradient_end">#0B7A46</color>

    <!-- Semantic status colors: occupancy levels, task urgency. Each has a
         matching *_container tint for icon/chip backgrounds. All text-weight
         values clear 4.5:1 on @color/surface. -->
    <color name="status_low">#1B7F4B</color>
    <color name="status_medium">#8A6100</color>
    <color name="status_high">#B3261E</color>
    <color name="status_low_container">#DFF3E7</color>
    <color name="status_medium_container">#FBEFD3</color>
    <color name="status_high_container">#FBE4E2</color>
    <color name="brand_container">#E3F2E9</color>
    <!-- Selection ring drawn over the campus illustration; white reads on the
         green building blocks in both light and dark mode. -->
    <color name="map_highlight">#FFFFFF</color>
</resources>
