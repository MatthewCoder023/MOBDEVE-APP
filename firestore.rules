rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Personal data: each account may only read and write its own subtree.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared crowd counters. These hold only a room name and a running total
    // for the current hour — never who checked in — so any signed-in account
    // can read them without exposing anyone's movements.
    //
    // Writes are constrained to the shape the app produces, and the count may
    // only move by one at a time, so a client cannot post an arbitrary figure
    // in a single request. This is deliberately not tamper-proof: a determined
    // client could still call it repeatedly. Making it authoritative needs the
    // increment to move server-side into a Cloud Function.
    match /crowd/{roomId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['room', 'count', 'hourKey', 'updatedAt'])
                   && request.resource.data.room is string
                   && request.resource.data.hourKey is string
                   && request.resource.data.count is int
                   && request.resource.data.count > 0
                   && (
                        // First write of the hour, or a fresh document.
                        !exists(/databases/$(database)/documents/crowd/$(roomId))
                        || resource.data.hourKey != request.resource.data.hourKey
                        ? request.resource.data.count == 1
                        // Same hour: a single increment only.
                        : request.resource.data.count == resource.data.count + 1
                      );
    }
  }
}
